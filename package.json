{
  "name": "last-survival",
  "private": true,
  "version": "1.3.1",
  "description": "Shooter de supervivencia vertical para el navegador del celular: mueve tu escuadrón, rompe barriles y resiste a los zombis.",
  "type": "module",
  "scripts": {
