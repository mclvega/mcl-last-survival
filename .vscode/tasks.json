{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vite: dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "beginsPattern": "VITE",
          "endsPattern": "localhost"
        }
      }
    },
    {
      "label": "vite: preview (build de producción)",
      "type": "shell",
      "command": "npm run build && npm run preview",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "beginsPattern": "last-survival@",
          "endsPattern": "localhost"
        }
      }
    }
  ]
}
